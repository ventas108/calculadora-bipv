+    resultado = invalidar_sombra_por_cambio_malla([sup], "externa_marsh-bbbb2222")
+    assert "p_shade" not in resultado[0]
+    assert "firma_sombra" not in resultado[0]
+    assert "escena" in resultado[0]["sombra_bloqueo_motivo"].lower()
